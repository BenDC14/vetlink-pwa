# VetLink PWA Environment Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: .env and .env.local are excluded by .gitignore and must NEVER be committed to Git.

# Optional Cloud / Custom Backend Base URL
# If left empty, the application defaults to http://localhost:8000 for local development.
# For Vercel production deployment, set this to your live Render backend URL:
# Example: https://vetlink-backend.onrender.com
VITE_API_BASE_URL=

